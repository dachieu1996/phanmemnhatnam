# Chép file này thành .env.local khi chạy ở máy cá nhân.
# Mọi biến NEXT_PUBLIC_* đều nằm trong JS gửi cho trình duyệt — KHÔNG đặt key/token vào đây.

# Địa chỉ API chatbot
#  - "off": không gọi server, trả lời bằng cơ sở tri thức trong trình duyệt (public/chat-kb.json).
#           Bản deploy GitHub Pages hiện dùng giá trị này.
#  - khi có chatbot server riêng: URL HTTPS đầy đủ, ví dụ https://api.phanmemnhatnam.com/api
#    (hợp đồng: docs/CHATBOT_API.md; server phải cho phép CORS từ tên miền website)
NEXT_PUBLIC_CHAT_API=off

# Địa chỉ website (dùng cho canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://phanmemnhatnam.com
